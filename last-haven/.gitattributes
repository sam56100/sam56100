# Normalise line endings: the whole project is LF (Godot reads LF fine on Windows).
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf

